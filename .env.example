# Copy this file to .env only if you prefer environment-variable model config.
# The recommended path is config/model_config.yaml; see README.md.

# OpenAI-compatible fallback config. Used only when config/model_config.yaml
# and the legacy config/global_config*.yaml files are absent.
AUTOENV_OPENAI_MODELS=google/gemini-3-flash-preview
AUTOENV_OPENAI_BASE_URL=https://openrouter.ai/api/v1
AUTOENV_OPENAI_API_KEY=your_api_key_here

# Provider-specific overrides. Set only the one that matches your route.
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Generic OpenAI-compatible fallback.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
